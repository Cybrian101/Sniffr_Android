# ============================================================================
# Sniffr — server environment variables
# Copy this file to server/.env and fill in real values. server/config.js
# loads server/.env directly (no dotenv dependency) -- this template must
# live next to it for `cp .env.example server/.env` to make sense, but the
# loader itself only ever reads server/.env, never this file.
# ============================================================================

PORT=3001
NODE_ENV=development

# Deployed frontend origin (e.g. https://your-app.vercel.app). Used to build
# links in transactional emails (verification, password reset, admin payment
# review). Leave blank for local dev -- falls back to http://localhost:5173.
CLIENT_URL=

# postgresql://<user>:<password>@<host>:<port>/<db>
# For local dev, run `npm run db:local` in server/ instead (spawns a
# throwaway local Postgres and prints the DATABASE_URL to use here).
DATABASE_URL=
# Supabase and most managed Postgres hosts require SSL (the default).
# Set to "false" only for a local Postgres with no SSL configured.
DATABASE_SSL=

# Required -- the server refuses to boot without these. Generate with e.g.
# `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Google Sign-In (Google Identity Services, verified server-side against
# Google's own tokeninfo endpoint -- NOT Supabase Auth). Must be a real
# Web application OAuth Client ID from Google Cloud Console. In production,
# that Client ID's "Authorized JavaScript origins" must list your real
# deployed frontend origin(s) (e.g. https://yourdomain.com and, if used,
# your Capacitor app's origin), or the Google sign-in popup will fail. The
# server refuses to verify any Google token if this is left blank -- it
# will NOT silently accept unverified logins.
GOOGLE_CLIENT_ID=
# Currently unused server-side (the Google flow only needs the Client ID to
# verify ID tokens) -- kept for a future server-side OAuth code exchange.
GOOGLE_CLIENT_SECRET=

# "local" (default, writes to server/uploads/ -- dev only, does NOT survive
# a Render redeploy since the filesystem is ephemeral) or "cloud"
# (Cloudinary, needs the three CLOUDINARY_* vars below). Production MUST
# use "cloud". Per-user storage usage/quota is tracked in Postgres
# regardless of which one is active (server/services/mediaService.js).
STORAGE_TYPE=local

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Comma-separated allowlist of origins the browser is allowed to call this
# API from (e.g. https://your-app.vercel.app). "*" allows any origin --
# fine for local dev, NOT usable in production: the server sends
# Access-Control-Allow-Credentials: true (needed for auth), and per the
# CORS spec browsers refuse a wildcard origin together with credentials --
# authenticated requests will simply fail. Set this to your real deployed
# frontend origin(s) before going live.
CORS_ORIGINS=*

# Reverse-proxy hops trusted for the client IP (Express 'trust proxy'); every
# IP rate limit keys on it. Default 1 (Render). To check on a deployment, set
# DEBUG_CLIENT_IP=1 and open /api/debug/client-ip (see server/index.js).
# TRUST_PROXY_HOPS=1
# DEBUG_CLIENT_IP=1

# Email (server/utils/mailer.js). Resend's HTTP API is used when
# RESEND_API_KEY is set (needed on hosts that block outbound SMTP, e.g.
# Render's free plan); otherwise SMTP below. With neither, in dev only,
# verification links / codes are logged to the console instead of emailed.
RESEND_API_KEY=
# EMAIL_FROM=Sniffr <no-reply@sniffrweb.com>   # default; must be on a Resend-verified domain

SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
# Optional -- only needed if switching to a domain/transactional provider later:
# SMTP_SECURE=true          # force implicit TLS; auto-detects from port 465 if unset
# SMTP_FROM_EMAIL=noreply@yourdomain.com   # visible sender, defaults to SMTP_USER
# SMTP_FROM_NAME=Sniffr 🐾                  # visible sender name

GOOGLE_PLACES_API_KEY=

# Supabase Auth (email/password login only -- Google Sign-In above is
# untouched and does not use these). Required for signup/login/password
# reset/change to work; the server will throw when those specific routes
# are hit if unset, but boots fine without them otherwise.
# SUPABASE_URL/ANON_KEY: Supabase dashboard -> Settings -> API (not secret,
# same values a browser client would use).
SUPABASE_URL=
SUPABASE_ANON_KEY=
# SERVICE_ROLE_KEY: same page, "service_role" key -- full admin access,
# bypasses every RLS policy. Server-only. NEVER expose this to the
# frontend, log it, or commit it.
SUPABASE_SERVICE_ROLE_KEY=

# Optional -- TURN relay for 1:1 voice/video calls (server/routes/calls.js).
# Without this, calls fall back to STUN-only, which works fine when both
# peers are on the same network/most home networks, but can fail to
# establish media on restrictive/symmetric NAT (common on mobile carrier
# networks) -- signaling will still succeed but no audio/video will flow.
# Comma-separated list of URLs if your provider gives you more than one
# (udp/tcp/tls).
# e.g. Metered.ca free tier: TURN_URLS=turn:standard.relay.metered.ca:80,turn:standard.relay.metered.ca:443,turns:standard.relay.metered.ca:443?transport=tcp
TURN_URLS=
TURN_USERNAME=
TURN_CREDENTIAL=
