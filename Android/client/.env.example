# Leave blank for local dev — api.js/socket.js fall back to same-origin
# requests, proxied by Vite to the backend (see vite.config.js).
# When set, this must be the backend's origin ONLY, no /api suffix --
# api.js appends /api itself, socket.js connects to this origin directly.
#   VITE_API_URL=http://localhost:3001        # local server, bypassing the Vite proxy
#   VITE_API_URL=https://sniffrweb.onrender.com  # production (Vercel/Capacitor build)
VITE_API_URL=

VITE_GOOGLE_CLIENT_ID=

# Real public web origin for share/invite links (see utils/platform.js's
# publicWebOrigin). Leave blank for a normal web build -- window.location.origin
# is already correct there. Must be set in client/.env.capacitor for the
# Android build, where window.location.origin resolves to the WebView's
# internal origin instead of a real, shareable URL.
VITE_WEB_URL=
